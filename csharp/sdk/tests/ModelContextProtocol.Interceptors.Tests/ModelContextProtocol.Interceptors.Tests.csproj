<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="ModelContextProtocol" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ModelContextProtocol.Interceptors\ModelContextProtocol.Interceptors.csproj" />
  </ItemGroup>

  <!-- Sample code with security-relevant logic, compiled in so SampleTests can cover it. -->
  <ItemGroup>
    <Compile Include="..\..\samples\WhyInterceptorsDemo\SecurityGuardInterceptors.cs" Link="Samples\SecurityGuardInterceptors.cs" />
    <Compile Include="..\..\samples\WhyInterceptorsDemo\AcmeWorkspaceTools.cs" Link="Samples\AcmeWorkspaceTools.cs" />
    <Compile Include="..\..\samples\InterceptorProxy\ProxyConfig.cs" Link="Samples\ProxyConfig.cs" />
  </ItemGroup>

</Project>
