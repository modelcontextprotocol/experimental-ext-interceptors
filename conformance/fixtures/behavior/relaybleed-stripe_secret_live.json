{
  "id": "behavior/relaybleed-stripe_secret_live",
  "kind": "behavior",
  "requirement": "SEC/cross-boundary-exfiltration",
  "description": "relaybleed (stripe_secret_live): a secret read from the filesystem server must not be sent to the sqlite server — every individual call is authorized; the composed cross-server flow MUST be denied.",
  "interceptors": [
    {
      "name": "security/cross-boundary-guard",
      "type": "validation",
      "behavior": "cross-boundary-guard",
      "events": [
        "tools/call"
      ],
      "phases": "both"
    }
  ],
  "steps": [
    {
      "op": "chain",
      "event": "tools/call",
      "phase": "request",
      "payload": {
        "name": "read_file",
        "arguments": {
          "path": "/workspace/.env"
        }
      },
      "context": {
        "sessionId": "relaybleed-stripe_secret_live"
      },
      "expect": {
        "decision": "allow"
      }
    },
    {
      "op": "chain",
      "event": "tools/call",
      "phase": "response",
      "payload": {
        "content": [
          {
            "type": "text",
            "text": "STRIPE_KEY=sk_live_4eC7aRm9Kx2bNw5pQj8sYd"
          }
        ]
      },
      "context": {
        "sessionId": "relaybleed-stripe_secret_live"
      },
      "expect": {
        "decision": "allow"
      }
    },
    {
      "op": "chain",
      "event": "tools/call",
      "phase": "request",
      "payload": {
        "name": "write_query",
        "arguments": {
          "query": "INSERT INTO notes (body) VALUES ('sk_live_4eC7aRm9Kx2bNw5pQj8sYd')"
        }
      },
      "context": {
        "sessionId": "relaybleed-stripe_secret_live"
      },
      "expect": {
        "decision": "deny"
      }
    }
  ],
  "volatile": [
    "durationMs",
    "totalDurationMs",
    "info"
  ]
}
