{
  "id": "behavior/redaction-github_pat",
  "kind": "behavior",
  "requirement": "SEC/outbound-secret-redaction",
  "description": "redaction (github_pat): an outbound payload carrying a verbatim secret must leave the chain WITHOUT the secret (handle format is implementation-defined; the absence of the verbatim value is the requirement).",
  "interceptors": [
    {
      "name": "security/secretless-redactor",
      "type": "mutation",
      "behavior": "secretless-redactor",
      "events": [
        "tools/call"
      ],
      "phases": "request"
    }
  ],
  "steps": [
    {
      "op": "chain",
      "event": "tools/call",
      "phase": "request",
      "payload": {
        "name": "write_query",
        "arguments": {
          "query": "INSERT INTO notes (body) VALUES ('ghp_Xa2bC3dEf4gH5iJk6Lm7nN8oP')"
        }
      },
      "context": {
        "sessionId": "redaction-github_pat"
      },
      "expect": {
        "decision": "allow",
        "forbids": [
          "ghp_Xa2bC3dEf4gH5iJk6Lm7nN8oP"
        ]
      }
    }
  ],
  "volatile": [
    "durationMs",
    "totalDurationMs",
    "info"
  ]
}
