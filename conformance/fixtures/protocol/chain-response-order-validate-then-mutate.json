{
  "id": "protocol/chain-response-order-validate-then-mutate",
  "kind": "protocol",
  "requirement": "SEP-2624/chain.response-order",
  "description": "Response phase runs validations BEFORE mutations: the validator must see the raw payload (deny); mutating first would allow.",
  "interceptors": [
    {
      "name": "conf/require-uppercase-note",
      "type": "validation",
      "behavior": "require-uppercase-note",
      "events": [
        "tools/call"
      ],
      "phases": "both"
    },
    {
      "name": "conf/uppercase-note",
      "type": "mutation",
      "behavior": "uppercase-note",
      "events": [
        "tools/call"
      ],
      "phases": "both"
    }
  ],
  "steps": [
    {
      "op": "apply",
      "event": "tools/call",
      "phase": "response",
      "payload": {
        "name": "echo",
        "arguments": {
          "note": "hello"
        }
      },
      "context": null,
      "expect": {
        "decision": "deny"
      }
    }
  ],
  "volatile": [
    "durationMs",
    "totalDurationMs",
    "info"
  ]
}
