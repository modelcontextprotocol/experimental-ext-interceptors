{
  "id": "protocol/invoke-mutation-unmodified",
  "kind": "protocol",
  "requirement": "SEP-2624/interceptor-invoke.mutation",
  "description": "interceptor/invoke of a mutator that declines returns modified=false with the original payload passed through.",
  "interceptors": [
    {
      "name": "conf/uppercase-note",
      "type": "mutation",
      "behavior": "uppercase-note",
      "events": [
        "tools/call"
      ],
      "phases": "both"
    }
  ],
  "steps": [
    {
      "op": "invoke",
      "params": {
        "name": "conf/uppercase-note",
        "event": "tools/call",
        "phase": "request",
        "payload": {
          "name": "echo",
          "arguments": {
            "other": 1
          }
        }
      },
      "expect": {
        "result": {
          "interceptor": "conf/uppercase-note",
          "type": "mutation",
          "phase": "request",
          "modified": false,
          "payload": {
            "name": "echo",
            "arguments": {
              "other": 1
            }
          }
        },
        "canonical": "{\"interceptor\":\"conf/uppercase-note\",\"modified\":false,\"payload\":{\"arguments\":{\"other\":1},\"name\":\"echo\"},\"phase\":\"request\",\"type\":\"mutation\"}"
      }
    }
  ],
  "volatile": [
    "durationMs",
    "totalDurationMs",
    "info"
  ]
}
